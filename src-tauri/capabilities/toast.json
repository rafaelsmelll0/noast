{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "toast-window",
  "description": "Permissões da janela de alertas do Noast (sem acesso ao cofre nem às notas)",
  "windows": [
    "toast"
  ],
  "permissions": [
    "core:default",
    "allow-get-pending-alerts",
    "allow-get-settings",
    "allow-hide-snooze-menu",
    "allow-hide-toast",
    "allow-mark-all-done",
    "allow-mark-done",
    "allow-open-main-from-toast",
    "allow-open-snooze-menu",
    "allow-present-toast",
    "allow-snooze-all",
    "allow-snooze-notification"
  ]
}
